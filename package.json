{
  "name": "dsh-skill-autoload",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin: auto-load the matching skill's instructions from the user's message, no trigger word needed, with a checkbox panel for picking which skills may auto-load. 按消息关键词自动加载已装技能的插件，无需触发词，并可在右侧栏勾选启用哪些技能。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "logic.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "skill",
    "skills",
    "autoload",
    "auto-injection",
    "sidebar"
  ],
  "license": "MIT",
  "author": "tshui1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tshui1/dsh-skill-autoload.git"
  },
  "homepage": "https://github.com/tshui1/dsh-skill-autoload#readme",
  "bugs": {
    "url": "https://github.com/tshui1/dsh-skill-autoload/issues"
  },
  "scripts": {
    "test": "node --test test-logic.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  }
}
